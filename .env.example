# Generate a strong secret key before deployment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=
# Default Groq chat model. You can change this to another model enabled for your Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# Retrieval configuration
RETRIEVER_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
